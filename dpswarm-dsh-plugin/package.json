{
  "name": "dpswarm-dsh-plugin",
  "version": "0.9.0",
  "description": "Explicit fixed-team and independent DeepSeek context management for DSH",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cm": {
      "default": "./lib/cm.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "bin": {
    "dpswarm-dsh-setup": "bin/setup.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "VALIDATION.md"
  ],
  "scripts": {
    "doctor": "node bin/setup.mjs --check",
    "test": "node --test tests/*.test.mjs"
  }
}
