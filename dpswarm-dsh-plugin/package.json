{
  "name": "dpswarm-dsh-plugin",
  "version": "0.15.1",
  "description": "Fixed-team collaboration, context management and evidence-bound acceptance for DSH",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cm": {
      "default": "./lib/cm.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "bin": {
    "dpswarm-dsh-setup": "bin/setup.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node bin/setup.mjs --check",
    "test": "cd .. && node --test dpswarm-dsh-plugin/tests/*.test.mjs",
    "test:unit": "node --test tests/acceptance-contract.test.mjs tests/acceptance-prompt-contract.test.mjs tests/handoff.test.mjs tests/write-scope.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiaclv/dpswarm.git",
    "directory": "dpswarm-dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/Jiaclv/dpswarm/issues"
  },
  "homepage": "https://github.com/Jiaclv/dpswarm/tree/main/dpswarm-dsh-plugin",
  "license": "SEE LICENSE IN LICENSE"
}
